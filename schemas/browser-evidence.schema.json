{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonflow.dev/schemas/html5assay.browser-evidence.v1.json",
  "title": "HTML5Assay browser qualification evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authoritative",
    "candidate",
    "environment",
    "executionTime",
    "network",
    "target",
    "flowTarget",
    "results",
    "failures",
    "result",
    "humanApprovalRequired",
    "evidenceDigest"
  ],
  "allOf": [
    {
      "if": { "type": "object", "properties": { "result": { "const": "Pass" } } },
      "then": {
        "type": "object",
        "properties": {
          "environment": {
            "type": "object",
            "properties": {
              "browserExecutables": { "type": "array", "minItems": 3, "maxItems": 3 }
            }
          },
          "results": { "type": "array", "minItems": 1 },
          "failures": { "type": "array", "maxItems": 0 }
        }
      },
      "else": {
        "type": "object",
        "properties": { "failures": { "type": "array", "minItems": 1 } }
      }
    }
  ],
  "properties": {
    "schemaVersion": { "const": "html5assay.browser-evidence.v1" },
    "authoritative": { "const": false },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitCommit", "archiveSha256"],
      "properties": {
        "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "archiveSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playwrightVersion",
        "browserRevisions",
        "browserExecutables",
        "operatingSystem",
        "nodeVersion",
        "container"
      ],
      "properties": {
        "playwrightVersion": { "const": "1.62.1" },
        "browserRevisions": { "$ref": "#/$defs/browserRevisions" },
        "browserExecutables": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              { "const": { "name": "chromium", "version": "151.0.7922.34" } },
              { "const": { "name": "firefox", "version": "153.0" } },
              { "const": { "name": "webkit", "version": "26.5" } }
            ]
          }
        },
        "operatingSystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "release", "architecture"],
          "properties": {
            "platform": { "type": "string", "minLength": 1 },
            "release": { "type": "string", "minLength": 1 },
            "architecture": { "type": "string", "minLength": 1 }
          }
        },
        "nodeVersion": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "container": { "$ref": "#/$defs/container" }
      }
    },
    "executionTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "finishedAt", "durationMilliseconds"],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "durationMilliseconds": { "type": "integer", "minimum": 0 }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browserRequests", "serviceWorkers", "hostDenial"],
      "properties": {
        "browserRequests": { "const": "loopback-only" },
        "serviceWorkers": { "const": "block" },
        "hostDenial": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "declared", "probe"],
          "properties": {
            "required": { "const": "docker-network-none" },
            "declared": { "const": "docker-network-none" },
            "probe": {
              "type": "object",
              "additionalProperties": false,
              "required": ["denied", "detail"],
              "properties": {
                "denied": { "const": true },
                "detail": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "target": { "type": "string", "pattern": "^/" },
    "flowTarget": { "type": "string", "pattern": "^/" },
    "results": { "type": "array", "items": { "type": "object" } },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "message"],
        "properties": {
          "scope": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "result": { "enum": ["Pass", "Fail"] },
    "humanApprovalRequired": { "const": true },
    "evidenceDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha-256" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "browserRevisions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "const": { "name": "chromium", "revision": "1234", "browserVersion": "151.0.7922.34" } },
        { "const": { "name": "firefox", "revision": "1538", "browserVersion": "153.0" } },
        { "const": { "name": "webkit", "revision": "2336", "browserVersion": "26.5" } }
      ],
      "items": false
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "platform", "digest", "reference", "networkMode"],
      "properties": {
        "image": { "const": "mcr.microsoft.com/playwright:v1.62.1-noble" },
        "platform": { "const": "linux/amd64" },
        "digest": {
          "const": "sha256:c091b21d9fae78c76e85cd4356431e9b018402f172a214fc7d7a5e9a7e29d8ac"
        },
        "reference": {
          "const": "mcr.microsoft.com/playwright@sha256:c091b21d9fae78c76e85cd4356431e9b018402f172a214fc7d7a5e9a7e29d8ac"
        },
        "networkMode": { "const": "none" }
      }
    }
  }
}
