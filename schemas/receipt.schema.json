{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonflow.dev/schemas/cff.assay.receipt.v1.json",
  "title": "CFF HTML5Assay receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "subject",
    "assay",
    "ruleset",
    "policy",
    "manifestDigest",
    "toolchain",
    "verdict",
    "resultDigest",
    "findingsDigest",
    "limits",
    "authorityLimitations",
    "toolFailures",
    "humanApprovalRequired"
  ],
  "properties": {
    "schemaVersion": { "const": "cff.assay.receipt.v1" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "digest"],
      "properties": { "root": { "const": "." }, "digest": { "$ref": "#/$defs/digest" } }
    },
    "assay": { "$ref": "#/$defs/identity" },
    "ruleset": { "$ref": "#/$defs/digestedIdentity" },
    "policy": { "$ref": "#/$defs/digestedIdentity" },
    "manifestDigest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "htmlParser", "cssParser"],
      "properties": {
        "node": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
        "htmlParser": { "const": "parse5/7.2.1" },
        "cssParser": { "const": "postcss/8.5.6" }
      }
    },
    "verdict": { "enum": ["Pass", "Fail", "Inconclusive", "ToolFailure"] },
    "resultDigest": { "$ref": "#/$defs/digest" },
    "findingsDigest": { "$ref": "#/$defs/digest" },
    "limits": { "type": "array", "items": { "$ref": "#/$defs/limit" } },
    "authorityLimitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "toolFailures": { "type": "array", "items": { "$ref": "#/$defs/toolFailure" } },
    "humanApprovalRequired": { "const": true }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha-256" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "digestedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^(?:[0-9]+\\.[0-9]+\\.[0-9]+|unknown)$" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "limit", "observed"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "limit": { "type": "integer", "minimum": 0 },
        "observed": { "type": "integer", "minimum": 0 },
        "path": { "type": "string", "not": { "pattern": "^(?:/|[A-Za-z]:[\\\\/])" } }
      }
    },
    "toolFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "evidenceDigest"],
      "properties": {
        "code": { "type": "string", "pattern": "^H5A-[A-Z0-9-]+$" },
        "evidenceDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
