{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonflow.dev/schemas/cff.assay.finding.v1.json",
  "title": "CFF assay finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ruleId",
    "ruleVersion",
    "authority",
    "level",
    "certainty",
    "outcome",
    "path",
    "range",
    "message",
    "observed",
    "expected",
    "remediation",
    "standards",
    "evidenceDigest"
  ],
  "properties": {
    "ruleId": {
      "type": "string",
      "pattern": "^H5A-(DOC|SEM|A11Y|CSS|SAFE|CFF|PERF|THEME)-[0-9]{3}$"
    },
    "ruleVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "authority": { "enum": ["standard", "cff-policy"] },
    "level": { "enum": ["blocking", "advisory"] },
    "certainty": { "enum": ["exact", "contextual", "heuristic"] },
    "outcome": { "enum": ["failed", "cantTell"] },
    "path": { "type": "string", "not": { "pattern": "^(?:/|[A-Za-z]:[\\\\/])" } },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/position" },
        "end": { "$ref": "#/$defs/position" }
      }
    },
    "message": { "type": "string", "minLength": 1 },
    "observed": { "type": "string" },
    "expected": { "type": "string", "minLength": 1 },
    "remediation": { "type": "string", "minLength": 1 },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority", "reference", "automationLimit"],
        "properties": {
          "authority": { "type": "string" },
          "reference": { "type": "string" },
          "automationLimit": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidenceDigest": { "$ref": "#/$defs/digest" },
    "suppression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suppressed"],
      "properties": {
        "suppressed": { "const": true },
        "owner": { "type": "string" },
        "reason": { "type": "string" },
        "expires": { "type": "string", "format": "date" }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "line", "column"],
      "properties": {
        "offset": { "type": "integer", "minimum": 0 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha-256" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
